# ── Stripe ──────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# From Stripe Dashboard > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Product IDs — create in Stripe Dashboard > Products
STRIPE_PRICE_STARTER=price_...      # $14 — 20 headshots
STRIPE_PRICE_PRO=price_...          # $24 — 40 headshots
STRIPE_PRICE_TEAM=price_...         # $149 — team (10 people)

# ── Astria AI ────────────────────────────────────────────
# Get from https://www.astria.ai/users/edit → API key
ASTRIA_API_KEY=sd_...

# ── Resend (email) ───────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=headshots@yourdomain.com

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
# Secret for internal API calls (generate with: openssl rand -hex 32)
INTERNAL_API_SECRET=your_random_secret_here
